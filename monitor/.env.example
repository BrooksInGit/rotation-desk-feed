# Copy to monitor/.env on the server and fill in. .env is git-ignored:
# never commit it or paste these values into chat.
# (Comments must be on their own lines; systemd does not strip trailing comments.)
ALPACA_KEY_ID=
ALPACA_SECRET_KEY=
# sip = all US exchanges (Algo Trader Plus); iex on the free plan
ALPACA_FEED=sip
# opra = live option quotes (Algo Trader Plus); indicative on the free plan
ALPACA_OPTIONS_FEED=opra
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
REPO_DIR=/opt/rotation-desk-feed
# 1 = write events/ and status.json back to the repo
GIT_PUSH=1
# backup check from 1-minute bars, option stop/target checks, watchlist pull + event push (seconds)
SWEEP_SECONDS=30
OPTION_SECONDS=15
FEED_SECONDS=30
