# Copy to monitor/.env on the server (cp .env.example .env) and fill in.
# .env is git-ignored. Never commit it or paste these values into chat.
ALPACA_KEY_ID=
ALPACA_SECRET_KEY=
ALPACA_FEED=sip              # all US exchanges (Algo Trader Plus). Use iex on the free plan.
ALPACA_OPTIONS_FEED=opra     # live option quotes (Algo Trader Plus). Use indicative on the free plan.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
REPO_DIR=/opt/rotation-desk-feed
GIT_PUSH=1                   # write events/ and status.json back to the repo
SWEEP_SECONDS=30             # backup check from 1-minute bars
OPTION_SECONDS=15            # option-premium stop/target checks
FEED_SECONDS=30              # pull watchlist.json and push events
